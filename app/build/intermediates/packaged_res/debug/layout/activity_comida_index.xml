<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.personal_trainner_mvc.Views.cliente.MainActivity"
    android:background="@color/fondoazul"
    >


    <!-- Barra Inferior-->

    <Button
        android:id="@+id/buttonCrearComidaI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="132dp"
        android:text="+"
        android:textSize="24sp"
        android:background="@drawable/radius"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/listViewComida" />

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="120dp"
        android:padding="10dp"
        android:background="@color/fondoazul"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints"


        >


        <TextView
            android:id="@+id/textViewcomida"
            android:layout_width="157dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="   Comidas"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="italic"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="parent"
            tools:layout_editor_absoluteY="parent" />

        <Button
            android:id="@+id/BAddCComida"
            android:layout_width="170dp"
            android:layout_height="50dp"
            android:background="@drawable/radius"
            android:textColor="@color/white"
            android:text="añadir categoria" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="411dp"
        android:layout_height="77dp"
        android:orientation="vertical"
        android:background="@color/fondoazul"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        >
        <!-- Incluir la barra inferior -->
        <include
            layout="@layout/bottom_bar"
            tools:layout_editor_absoluteX="parent"
            tools:layout_editor_absoluteY="parent"


            />
    </LinearLayout>


    <ListView
        android:id="@+id/listViewComida"
        android:layout_width="368dp"
        android:layout_height="606dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="64dp"

        android:divider="@android:color/transparent"
        android:dividerHeight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints" />


    <!-- android:divider="@android:color/darker_gray" -->

</androidx.constraintlayout.widget.ConstraintLayout>