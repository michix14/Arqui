<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white"

        android:gravity="center_horizontal">

        <!-- Campo para el descripcion del cliente -->
        <EditText
            android:id="@+id/editTextCENombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:inputType="text"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext"
            android:layout_marginBottom="16dp" />

        <!-- Campo para el email del cliente -->
        <EditText
            android:id="@+id/editTextCEDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descipcion"
            android:inputType="text"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext"
            android:layout_marginBottom="16dp" />

        <!-- Campo para el número de celular -->

        <!-- Campo para el peso del cliente -->
        <EditText
            android:id="@+id/editTextCEvideourl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Link"
            android:inputType="text"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext"
            android:layout_marginBottom="16dp" />



        <Spinner
            android:id="@+id/editTextCEgrupomuscularid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:layout_marginBottom="10dp"

            android:background="@drawable/rounded_edittext" />

        <!-- Campo para la altura del cliente -->





        <!-- Botón para guardar los datos -->




    </LinearLayout>





    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_bar_radius"
        android:orientation="vertical"

        android:gravity="center_horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/buttonGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Ejercicio"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/radius"
            android:backgroundTint="#38AF2A"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Botón para regresar a la pantalla anterior -->
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atrás"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C9D4D4"
            android:background="@drawable/radius"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />





        <!-- Incluir la barra inferior -->
        <include
            layout="@layout/bottom_bar"
            android:layout_width="375dp"
            android:layout_height="66dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>