<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="109dp"
        android:background="@drawable/radius_item"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.011"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="1dp">


        <Button
            android:id="@+id/enviarpdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/drafts_24px"
            android:text="" />

        <Button
            android:id="@+id/btnRutinaEjercicio"
            android:layout_width="234dp"
            android:layout_height="96dp"
            android:background="@android:color/transparent"
            android:text="Cliente"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnRutinaEjercicioDelete"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:background="@drawable/delete_24px"

            android:textSize="18sp" />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>