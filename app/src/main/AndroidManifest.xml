<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrimerP_Arqui_entrenador_java"
        tools:targetApi="31">


        <!-- Actividad principal -->
        <activity
            android:name="com.example.personal_trainner_mvc.Views.cliente.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Otras actividades -->
        <activity
            android:name="com.example.personal_trainner_mvc.Views.cliente.VClienteCreate" />

        <activity
            android:name="com.example.personal_trainner_mvc.Views.Categoria.VCategoria"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name="com.example.personal_trainner_mvc.Views.comida.VCategoriaComida"
            android:windowSoftInputMode="adjustPan" />

        <activity
        android:name="com.example.personal_trainner_mvc.Views.ejercicio.VEjercicioIndex"
        android:windowSoftInputMode="adjustPan" />

        <activity
            android:name="com.example.personal_trainner_mvc.Views.suscripcion.VSuscripcionIndex"
            android:windowSoftInputMode="adjustPan" />

        <activity android:name="com.example.personal_trainner_mvc.Views.ejercicio.VEjercicioCreate">

        </activity>


        <activity android:name="com.example.personal_trainner_mvc.Views.suscripcion.VSuscripcionCreate">

        </activity>
        <activity android:name="com.example.personal_trainner_mvc.Views.rutina.VRutinaIndex">

        </activity>
        <activity android:name="com.example.personal_trainner_mvc.Views.rutina.VRutinaCreate">

        </activity>
        <activity android:name="com.example.personal_trainner_mvc.Views.comida.VComidaIndex">

        </activity>


        <activity android:name="com.example.personal_trainner_mvc.Views.comida.VComidaCreate">

        </activity>

        <activity android:name="com.example.personal_trainner_mvc.Views.rutinaejercicios.VRutinaEjercicioCreate">

        </activity>


        <activity android:name="com.example.personal_trainner_mvc.Views.rutinaejercicios.VRutinaEjercicioIndex">

        </activity>
        <activity android:name="com.example.personal_trainner_mvc.Views.cronograma.VCronogramaCreate">
        </activity>
        <activity android:name="com.example.personal_trainner_mvc.Views.cronograma.VCronogramaShow">

        </activity>

        <activity android:name="com.example.personal_trainner_mvc.Views.cliente.VClienteShow">

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:ignore="WrongManifestParent">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>



    </application>


    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />




    <!--
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:required="false" />
     -->

</manifest>
